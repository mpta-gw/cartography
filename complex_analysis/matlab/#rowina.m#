function rowina
% function rowina
% load in MPTA data in order to calculate sky maps and perform regularisation

% load X and Fisher matrix from previous analysis
% replace the following lines with real X and Fisher
%X = [1 1 0 0]';
%fisher = diag([2 1 1 1]);
%load in isotropic no_cc marticies
tempfisher = readmatrix("dat/M_sph.dat", "OutputType","double");
tempX  = readmatrix("dat/X_sph.dat", "OutputType","double");
tempX = tempX(:,2);
save('mpta_complex.mat', 'tempX', 'tempfisher');

% load MPTA data products
% from home/rowina.nathan/mpta/ligo_code/mpta_complex.mat
%tmp = load('mpta_240214.mat');
X = 0*tempX;
fisher = 0*tempfisher;
% rearrange entries in order to match LIGO convention
N = length(X);
Lmax = sqrt(N)-1;
% lvec and mvec are the (l,m) values assumed by LIGO code
[lvec, mvec] = getLMvec(Lmax);
% lvec_pta and mvec_pta is the ordering assumed by PTA 
lvec_pta = [];
mvec_pta = [];
for ll=0:Lmax
  for mm=-ll:ll
    lvec_pta = [lvec_pta ll];
    mvec_pta = [mvec_pta mm];
  end
end
% carry out conversion
for ii=1:N
  idx_ii = lvec_pta==lvec(ii) & mvec_pta==mvec(ii);
  X(ii) = tempX(idx_ii);
  for jj=1:N
    idx_jj = lvec_pta==lvec(jj) & mvec_pta==mvec(jj);
    fisher(ii,jj) = tempfisher(idx_ii, idx_jj);
  end
end
% the PTA format uses real-valued spherical harmonics, but we need complex
%[X, lvec, mvec] = plmreal2plm(X);

% isotropic sanity check
sigma00 = subFisher(fisher,0)^-0.5;
p00 = inv(subFisher(fisher,0))*subX(X,0);
fprintf('isotropic SNR = %1.3e\n', p00/sigma00);

% set regularisation method
% 1: Keep all eigenvalues with eg(ii)/max(eg) >= regCutoff
% 2: Keep a fraction of all eigenvalues, regCutoff is that fraction; 
% 3: Keep N=regCutoff of all eigenvalues; 
%   1-3: All modified eigenvalues are set to the smallest non-modified value. 
% 11: Keep all eigenvalues with eg(ii)/max(eg) >= regCutoff
% 12: Keep a fraction of all eigenvalues, regCutoff is that fraction; 
% 13: Keep N=regCutoff of all eigenvalues; 
%   11-13: All modified eigenvalues are set to infinity, i.e. corresponding
%          eigenvalue of invfisher is set to zero.
% For LIGO, we used regMethod = 12, regCutoff = 2/3.
%regMethod = 12;
%regCutoff = 2/3;
% the following settings are appropriate for MPTA array
regMethod = 13;
regCutoff = 47;

% invert Fisher matrix
% pCovar is the covariance matrix of the clean map
[invfisher, pCovar] = reginv(fisher, regMethod, regCutoff);

% calculate the clean map
p_opt = invfisher*X;

% pixel map resolution in degrees
res=1;

% calculate sigma map
% sigmaPix: the sigma map
% (RA, DEC): arrays of right ascension and declination for mapping
[sigma, sigmaPix, RA, DEC, dOmg, U] = getSigmaMap(pCovar, res); 

% make the clean map
[clean_map, ra, dec] = makemap(p_opt, res);

% make a 2D array of clean map and sigma map
sn=[clean_map, sigmaPix];

% save workspace
save('rowina.mat');

% make plots of everything... starting with SNR
%  the -1 number is for a variable called spt, which has a default value = 0.
%  I think you can use this pass clean and sigma separately.
plotMapAitoff(clean_map./sigmaPix, 360, 181, -1);
print('-dpng', 'img/snr')

% plot sigma map
plotMapAitoff(sigmaPix, 360, 181, -1);
print('-dpng', 'img/sigma')

% plot clean map
plotMapAitoff(clean_map, 360, 181, -1);
print('-dpng', 'img/clean')

return
